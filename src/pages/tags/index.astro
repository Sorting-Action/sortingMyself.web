---
import Base from '../../layouts/Base.astro';
import { getPublishedNotes, getAllTags } from '../../lib/notes';

const notes = await getPublishedNotes();
const tags = [...getAllTags(notes).entries()].sort(
  (a, b) => b[1].length - a[1].length,
);
---

<Base title="标签">
  <h1>标签</h1>
  <p class="motto">标签即关联</p>

  <div class="tag-cloud">
    {
      tags.map(([tag, tagged]) => (
        <a href={`/tags/${tag}/`}>
          {tag}
          <small>{tagged.length}</small>
        </a>
      ))
    }
  </div>
</Base>
