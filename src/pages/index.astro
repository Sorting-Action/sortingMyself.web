---
import Base from '../layouts/Base.astro';
import {
  getPublishedNotes,
  noteUrl,
  noteCategory,
  excerpt,
} from '../lib/notes';

const notes = await getPublishedNotes();
---

<Base title="首页">
  <h1>学习记录</h1>
  <p class="motto">温故而知新，可以为师矣</p>

  {
    notes.map((note) => (
      <article class="feed-item">
        <h2>
          <a href={noteUrl(note)}>{note.data.title}</a>
        </h2>
        <p class="feed-meta">
          {note.data.created.toISOString().slice(0, 10)} ·{' '}
          <a href={`/categories/${noteCategory(note)}/`}>
            {noteCategory(note)}
          </a>
        </p>
        <p class="feed-excerpt">{excerpt(note)}</p>
      </article>
    ))
  }
</Base>
