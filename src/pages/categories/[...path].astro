---
import Base from '../../layouts/Base.astro';
import CategoryTree from '../../components/CategoryTree.astro';
import CategoryPath from '../../components/CategoryPath.astro';
import {
  getPublishedNotes,
  buildCategoryTree,
  collectCategoryPaths,
  noteUrl,
  type CategoryNode,
} from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  const tree = buildCategoryTree(notes);
  return collectCategoryPaths(tree).map((node) => ({
    params: { path: node.path },
    props: { node },
  }));
}

interface Props {
  node: CategoryNode;
}
const { node } = Astro.props;
---

<Base title={`分类：${node.name}`}>
  <h1><CategoryPath path={node.path} /></h1>

  {
    node.children.length > 0 && (
      <section class="cat-section">
        <CategoryTree nodes={node.children} />
      </section>
    )
  }

  {
    node.notes.length > 0 && (
      <section class="cat-section">
        <h2>文章</h2>
        <ul>
          {node.notes.map((note) => (
            <li>
              <a href={noteUrl(note)}>{note.data.title}</a>
              <small> · {note.data.created.toISOString().slice(0, 10)}</small>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
