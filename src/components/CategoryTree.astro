---
import { collectNotes, type CategoryNode } from '../lib/notes';

interface Props {
  nodes: CategoryNode[];
}
const { nodes } = Astro.props;
---

<ul>
  {
    nodes.map((node) => {
      const total = collectNotes(node).length;
      return (
        <li>
          <a href={`/categories/${node.path}/`}>{node.name}</a>
          {total > 0 && <small> ({total})</small>}
          {node.children.length > 0 && <Astro.self nodes={node.children} />}
        </li>
      );
    })
  }
</ul>
